{
  "expo": {
    "name": "SYNERGIA",
    "slug": "synergia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sira.guinee.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b5e3b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.billetterie.gn",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "test.synergia-guinee.com",
              "pathPrefix": "/paiement/retour"
            },
            {
              "scheme": "https",
              "host": "synergia-guinee.com",
              "pathPrefix": "/paiement/retour"
            },
            {
              "scheme": "https",
              "host": "www.synergia-guinee.com",
              "pathPrefix": "/paiement/retour"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1b5e3b"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SYNERGIA utilise l'appareil photo pour lire le code QR des billets à l'embarquement."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1b5e3b"
        }
      ]
    ],
    "scheme": [
      "sira",
      "synergia"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
